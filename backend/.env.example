# 백엔드 환경변수 예시 — 복사 후 .env 로 이름 변경

# ─── 관리자 계정 (Swagger 문서 + 관리자 API) ───
KIOSK_USERNAME=your_admin_username
KIOSK_PASSWORD=your_admin_password
ADMIN_API_KEY=your_admin_api_key

# ─── DB 연결 URL ───
# 로컬 MySQL:        mysql+aiomysql://your_user:your_password@127.0.0.1:3306/your_db
# Aiven Cloud:       mysql+aiomysql://your_user:your_password@your_host.aivencloud.com:your_port/defaultdb
# TiDB Cloud:        mysql+aiomysql://your_user:your_password@your_host.tidbcloud.com:4000/test
DATABASE_CONN=

# ─── Google Gemini API (음성 주문 LLM 응답용) ───
GENAI_API_KEY=your_google_genai_api_key
GENAI_TTS_ENABLED=false

# Face analysis model
FACE_MODEL_PATH=backend/models/0424model.pth
FACE_INSIGHTFACE_MODEL_NAME=buffalo_l
FACE_USE_CUDA=true
FACE_DETECTION_WIDTH=320
FACE_DETECTION_HEIGHT=320
FACE_DETECTION_SCORE_THRESHOLD=0.5
FACE_MIN_FACE_SIZE=120
FACE_MIN_VALID_FRAMES=5

# ─── Edge-TTS (Microsoft Azure Neural 음성, 무료) ───
# 합성 실패/패키지 미설치 시 자동으로 브라우저 TTS 폴백.
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE=ko-KR-SunHiNeural

# Naver DataLab API
NAVER_TREND_ENABLED=false
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
TREND_CACHE_TTL=3600

# Recommendation CSV bootstrap
STARTUP_DB_WRITE_ENABLED=false
RECOMMENDATION_BOOTSTRAP_ON_STARTUP=false
RECOMMENDATION_BOOTSTRAP_BATCH_SIZE=2000
